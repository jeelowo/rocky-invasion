[sub_resource type="GDScript" id="GDScript_fhrgm"]
script/source = "extends CharacterBody2D

@onready var alien_split: Node2D = $\"Alien Split\"
@onready var animated_sprite_2d: AnimatedSprite2D = $AnimatedSprite2D
@onready var timer: Timer = $Timer
@onready var ship: Node2D = $\"../../Ship/CharacterBody2D\"

@export var speed = 60
@export var can_split := true
@export var start_animation := \"second_variant\"

var health = 5

func _ready() -> void:
	add_to_group(\"enemy\")
	animated_sprite_2d.play(start_animation)
	
func movetoship():
	var direction = global_position.direction_to(ship.global_position)
	velocity = speed * direction
	move_and_slide()

func _physics_process(delta: float) -> void:
	movetoship()

func take_damage(amount: int):
	if(health > 0):
		health -= amount
		speed = 0
		
		# turn red
		self.modulate = Color.ORANGE_RED
		await get_tree().create_timer(0.2).timeout
		self.modulate = Color.WHITE
		speed = 60
		#print(health)
	
	if health <= 0:
		if can_split:
			alien_split.split()
		queue_free()
"

