[sub_resource type="GDScript" id="GDScript_b6em2"]
script/source = "extends Node2D

@onready var health = 5

func take_damage(damage: int):
	if health > 0:
		health -= damage
	
	if health <= 0:
		get_parent().queue.free()
"

[sub_resource type="GDScript" id="GDScript_4g0pa"]
script/source = "extends Node2D

var velocity
var angle : float
var direction : Vector2
@export var laser_speed = 100
@onready var ship: Node2D = $\"../Ship/CharacterBody2D\"

func _ready() -> void:
	preload(\"res://Scenes/basic_laser.tscn\")

func _physics_process(delta: float) -> void:
	print(direction)
	
func shoot(laser: Area2D):
	print(\"shoot\")
	angle = ship.global_rotation_degrees
	direction = ship.global_position.direction_to(get_global_mouse_position())
	#move_toward(0, direction,laser_speed)
"

[sub_resource type="GDScript" id="GDScript_wowpa"]
script/source = "extends Area2D

var ship_rotation
@onready var laser: Node = $\"..\"

func _ready() -> void:
	preload(\"res://Scenes/basic_laser.tscn\")

func _process(delta: float) -> void:
	if Input.is_action_pressed(\"shoot\"):
		laser.shoot(self)
"

